<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>shareW</AssemblyName>
    <RootNamespace>ShareW</RootNamespace>
    <Product>shareW</Product>
    <Company>shareW contributors</Company>
    <Description>Captura y anotación local basada en ShareX 22.4.0</Description>
    <Version>0.1.3</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ShareX.ScreenCaptureLib/ShareX.ScreenCaptureLib.csproj" />
  </ItemGroup>
</Project>
